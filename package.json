{
  "name": "obs-mouse-overlay",
  "version": "1.0.0",
  "description": "Cute mouse and keyboard Browser Source overlays for OBS.",
  "author": "Pink Kitty Overlay contributors",
  "private": true,
  "type": "module",
  "main": "desktop.mjs",
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs --demo",
    "desktop": "electron .",
    "build:music": "dotnet publish music-reader/PickMe.MusicReader.csproj -c Release -o music/reader",
    "dist": "npm run build:music && electron-builder --win portable"
  },
  "dependencies": {
    "express": "^5.1.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.pinkkitty.obsoverlay",
    "productName": "PickMe Overlay",
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "music/media-session.ps1"
    ],
    "files": [
      "server.mjs",
      "desktop.mjs",
      "overlay/**/*",
      "keyboard/**/*",
      "music/**/*",
      "settings/**/*",
      "skins/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PickMe-Overlay-${version}-portable.exe"
    }
  }
}
